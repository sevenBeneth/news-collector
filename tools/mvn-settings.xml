<?xml version="1.0" encoding="UTF-8"?>
<!--
  项目专用 Maven 配置
  背景：本机 conf/settings.xml 把 localRepository 指向了不存在的 D:\maven\rep，
        且把 central 镜像到 aliyun，导致离线/在线解析缓存时都会重新下载。
  此文件把本地仓库指回默认的 ~/.m2/repository，并停用该镜像的 mirrorOf 匹配，
  使已缓存依赖可直接复用（缺失的依赖仍会从 repo.maven.apache.org 下载）。
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">
    <localRepository>C:\Users\seven_beneath\.m2\repository</localRepository>
    <mirrors>
        <mirror>
            <id>aliyunmaven</id>
            <mirrorOf>disabled-by-project-settings</mirrorOf>
            <url>https://maven.aliyun.com/repository/public</url>
        </mirror>
    </mirrors>
</settings>
